# ============================================================================
# ACS Prototype — Environment Configuration
# ============================================================================
# Copy this file to .env.local:   cp .env.local.template .env.local
# All VITE_ prefixed vars are available in browser code via import.meta.env
# ============================================================================

# ── StackRox Central Connection ─────────────────────────────────────────────
# Points to: LIVE StackRox Central instance
# The Vite dev server proxies /stackrox-api/* → this URL (see vite.config.js)
# Example: https://central.stackrox.svc:443 or https://staging.demo.stackrox.com
VITE_STACKROX_URL=

# ── API Authentication ──────────────────────────────────────────────────────
# Points to: LIVE StackRox Central API
# Auth type: Bearer token (JWT)
# Generate from: StackRox Central → Platform Configuration → Integrations → API Token
# Required role: at minimum "Analyst" for read-only; "Admin" for full access
# Token format: JWT (eyJhbGciOi...)
VITE_STACKROX_TOKEN=

# ── Sync Configuration (optional) ──────────────────────────────────────────
# Auto-sync poll interval in milliseconds (default: 30000 = 30 seconds)
# Set to 0 to disable auto-sync (manual only via Sync Now button)
# VITE_SYNC_INTERVAL=30000

# ── Mock Data Behavior (optional) ──────────────────────────────────────────
# When true (default), falls back to mock data if live API is unreachable
# When false, shows error state instead of mock data
# VITE_USE_MOCK_FALLBACK=true

# ============================================================================
# Data Source Reference
# ============================================================================
#
# All data comes from StackRox Central via these endpoints:
#
# REST API (v1):
#   GET /v1/metadata                    → Connection test, version info
#   GET /v1/clusters                    → Cluster list (secured clusters)
#   GET /v1/namespaces                  → Namespace list
#   GET /v1/deployments/:id             → Single deployment detail
#   GET /v1/images                      → Image list
#   GET /v1/imagescount                 → Image count
#   GET /v1/alerts                      → Violations/alerts list
#   GET /v1/alertscount                 → Alert count
#   GET /v1/policies                    → Security policies
#   GET /v1/integrationhealth/vulndefinitions → Vulnerability definitions health
#
# REST API (v2):
#   GET /v2/reports/configurations      → Report configurations
#   GET /v2/reports/configurations/:id  → Single report config
#   GET /v2/reports/configuration-count → Report config count
#   GET /v2/vulnerability-exceptions    → Vulnerability exception requests
#   GET /v2/compliance/profiles         → Compliance profiles
#
# GraphQL:
#   POST /api/graphql                   → Summary counts, deployments with
#                                         CVE severity, image CVE list
#
# No external third-party services (Stripe, Firebase, etc.) are used.
# No traditional database — StackRox Central IS the data backend.
# ============================================================================
